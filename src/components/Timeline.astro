---
// 交替式年表（mtl）。沿革（History）使用：每筆 term（日期）+ desc（事件）。
// 歷屆夥伴改用 Roster.astro（職位—名稱清單），不再共用此元件。
interface Props {
  items: { term: string; desc: string }[];
}
const { items } = Astro.props;
---

<div class="mtl">
  {
    items.map((it, i) => (
      <div class={"mtl__row " + (i % 2 ? "mtl__row--right" : "mtl__row--left")}>
        <div class="mtl__card">
          <p class="mtl__term">{it.term}</p>
          <p class="mtl__desc">{it.desc}</p>
        </div>
        <span class="mtl__node" aria-hidden="true" />
      </div>
    ))
  }
</div>
