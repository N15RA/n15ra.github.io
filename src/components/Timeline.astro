---
// 交替式年表（mtl）。沿革（History）與歷屆夥伴（Members）共用；後者帶照片佔位。
interface Props {
  items: { term: string; desc: string; photo?: boolean }[];
  photoLabel?: string;
}
const { items, photoLabel = "歷屆合照" } = Astro.props;
---

<div class="mtl">
  {
    items.map((it, i) => (
      <div class={"mtl__row " + (i % 2 ? "mtl__row--right" : "mtl__row--left")}>
        <div class="mtl__card">
          {it.photo && (
            <div class="mtl__photo" aria-hidden="true">
              {photoLabel}
            </div>
          )}
          <p class="mtl__term">{it.term}</p>
          <p class="mtl__desc">{it.desc}</p>
        </div>
        <span class="mtl__node" aria-hidden="true" />
      </div>
    ))
  }
</div>
