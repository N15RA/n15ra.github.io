---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Hex from "./Hex.astro";
import Button from "./Button.astro";
import CourseCard from "./CourseCard.astro";
import SocialList from "./SocialList.astro";
import photoEnlightened from "../assets/photo-enlightened-2019.jpg";
import { PILLARS } from "../data/pillars";
import { SITE, SLOGAN, JOIN_INFO } from "../data/site";
import { getLocale, localizePath } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const lessonHref = localizePath("/lesson", locale);
const aboutHref = localizePath("/about", locale);

// 動態取「最新、非示意、且有課程」的學期作為首頁近期社課，避免硬編學期 id。
const semesters = await getCollection("semesters");
const recent = [...semesters]
  .sort((a, b) => b.data.order - a.data.order)
  .find((s) => !s.data.scaffold && s.data.courses.length > 0);
const recentCourses = recent?.data.courses.slice(0, 3) ?? [];
---

<header class="hero" data-theme="dark">
  <Hex class="hero__hexwatermark" />
  <div class="hero__constellation" aria-hidden="true">
    <Hex class="hero__float hero__float--1" />
    <Hex class="hero__float hero__float--2" />
    <Hex class="hero__float hero__float--3" />
    <Hex class="hero__float hero__float--4" />
    <Hex class="hero__float hero__float--5" />
  </div>
  <div class="wrap hero__inner">
    <p class="kicker">// Fu Jen Catholic University · since {SITE.since}</p>
    <h1>資訊安全，<br />從動手開始。</h1>
    <p class="hero__slogan">{SLOGAN}</p>
    <p class="hero__lead">
      NISRA 是一群由輔仁大學資工系學生組成的資安社團，致力於研究與推廣資訊安全相關知識。
    </p>
    <div class="hero__cta">
      <Button variant="primary" size="lg" href="#join">加入我們</Button>
      <Button variant="outline" size="lg" href={lessonHref}>看看課程</Button>
    </div>
    <div class="hero__facts">
      <div class="hero__fact">
        <span class="hero__fact-k">時間</span>
        <span class="hero__fact-v">每週二 19:00–21:00</span>
        <span class="hero__fact-s">學期間．考試週前後不開課</span>
      </div>
      <div class="hero__fact">
        <span class="hero__fact-k">地點</span>
        <span class="hero__fact-v">輔大資工系 · 聖言樓 SF645</span>
        <span class="hero__fact-s">新北市新莊區中正路 510 號</span>
      </div>
      <div class="hero__fact">
        <span class="hero__fact-k">參加</span>
        <span class="hero__fact-v">免費・自由參加</span>
        <span class="hero__fact-s">不分學校學籍．直接來教室就行</span>
      </div>
    </div>
  </div>
</header>

<section class="section">
  <div class="wrap">
    <div class="section__split">
      <div class="section__split-lead">
        <p class="kicker">// Who are we</p>
        <h2>We are NISRA</h2>
      </div>
      <div class="section__split-body">
        <p>
          是一群由輔仁大學資工系學生組成的資安社團，目的在於研究及推廣資訊安全相關知識。我們把學習拆成三件事——<strong
            >一起講、一起留下、一起把系統變得更安全。</strong
          >
        </p>
      </div>
    </div>
    <div class="grid grid--3" style="margin-top:40px">
      {
        PILLARS.map((p) => (
          <div class="card pillar">
            <div class="card__accent" />
            <div class="card__body">
              <h3 class="card__title pillar__name">{p.k}</h3>
              <p class="pillar__essence">{p.e}</p>
              <p class="card__desc">{p.d}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

{
  recent && (
    <section class="section section--sunk">
      <div class="wrap">
        <div
          class="section__head"
          style="display:flex; justify-content:space-between; align-items:flex-end; max-width:none"
        >
          <div>
            <p class="kicker">// Lesson · {recent.id}</p>
            <h2 style="margin:6px 0 0">近期社課</h2>
          </div>
          <Button variant="ghost" href={lessonHref}>
            所有課程 →
          </Button>
        </div>
        <div class="grid grid--3">
          {recentCourses.map((c) => (
            <CourseCard course={c} />
          ))}
        </div>
      </div>
    </section>
  )
}

<section class="section">
  <div class="wrap">
    <div class="grid grid--2" style="align-items:center; gap:40px">
      <Image
        src={photoEnlightened}
        alt="NISRA 社課與密訓合影"
        widths={[480, 800]}
        sizes="(max-width: 860px) 92vw, 540px"
        style="border-radius:var(--r-lg); box-shadow:var(--shadow-md); width:100%; height:auto;"
      />
      <div class="section__head" style="margin:0">
        <p class="kicker">// Community</p>
        <h2 style="margin:6px 0 0">不只是上課，是一群人</h2>
        <p style="margin-top:14px">
          從寒暑假密訓到比賽前的通宵練題，NISRA 是一個會一直陪你成長的社群。
        </p>
        <div style="margin-top:18px">
          <Button variant="outline" href={aboutHref}>我們的故事 →</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section--sunk" id="join">
  <div class="wrap">
    <div class="section__head" style="text-align:center; margin:0 auto 44px; max-width:50ch">
      <p class="kicker">// Join</p>
      <h2 style="margin:6px 0 14px">如何加入 NISRA</h2>
      <p style="color:var(--fg-muted); margin:0">
        什麼都不用帶，不需要申請、也不需要會費——只要有心，不分學校學籍，人人都能加入。
      </p>
    </div>
    <div class="join-grid">
      <div class="join-point">
        <p class="kicker">// WHEN</p>
        <p set:html={JOIN_INFO.whenLines.join("<br />")} />
      </div>
      <div class="join-point">
        <p class="kicker">// WHERE</p>
        <p set:html={JOIN_INFO.whereLines.join("<br />")} />
      </div>
      <div class="join-point">
        <p class="kicker">// HOW</p>
        <p set:html={JOIN_INFO.howLines.join("<br />")} />
      </div>
    </div>
    <div class="join-social">
      <SocialList class="socials--center" />
    </div>
  </div>
</section>
