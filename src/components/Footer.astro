---
import SocialIconRow from "./SocialIconRow.astro";
import { SITE } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer" data-theme="dark">
  <div class="wrap footer__grid">
    <div class="footer__brand-col">
      <div class="footer__brand">
        <img class="footer__logo" src="/logo-nisra.svg" alt="NISRA" width="53" height="60" />
      </div>
      <p class="footer__tag">{SITE.fullName}</p>
      <SocialIconRow />
    </div>
    <nav class="footer__links" aria-label="頁尾導覽">
      <a href="/about">About us</a>
      <a href="/event">Event</a>
      <a href="/lesson">Lesson</a>
      <a href={SITE.hackathonUrl} target="_blank" rel="noreferrer">Hackathon ↗</a>
    </nav>
    <div class="footer__contact">
      <p>輔仁大學 資訊工程學系</p>
      <p>新北市新莊區中正路 510 號</p>
      <p>聖言樓 SF645</p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
  <div class="wrap footer__legal">
    <span>© {SITE.since}–{year} {SITE.shortName}</span>
    <span>{SITE.domain}</span>
  </div>
</footer>
