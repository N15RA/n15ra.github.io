---
import SocialIconRow from "./SocialIconRow.astro";
import { SITE } from "../data/site";
import { getLocale, useTranslations, localizePath } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="footer" data-theme="dark">
  <div class="wrap footer__grid">
    <div class="footer__brand-col">
      <div class="footer__brand">
        <img class="footer__logo" src="/logo-nisra.svg" alt="NISRA" width="53" height="60" />
      </div>
      <p class="footer__tag">{SITE.fullName}</p>
      <SocialIconRow />
    </div>
    <nav class="footer__links" aria-label={t("footer.navLabel")}>
      <a href={localizePath("/about", locale)}>About us</a>
      <a href={localizePath("/event", locale)}>Event</a>
      <a href={localizePath("/lesson", locale)}>Lesson</a>
      <a href={SITE.hackathonUrl} target="_blank" rel="noreferrer">{t("footer.hackathon")} ↗</a>
    </nav>
    <div class="footer__contact">
      <p>{t("footer.dept")}</p>
      <p>{t("footer.room")}</p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
  <div class="wrap footer__legal">
    <span>© 2007–{year} NISRA</span>
    <span>{SITE.domain}</span>
  </div>
</footer>
