---
// 英文 scaffold 用：頁面頂部的全寬提示條，標示此頁尚未翻譯、以下顯示繁中內容。
// 不編造英文、不 404；待社團補上英文後移除即可。
import { getLocale, useTranslations } from "../i18n/utils";
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<div class="tp-bar" role="note">
  <div class="wrap tp-bar__inner">
    <span class="tp-label">{t("tp.label")}</span>
    <p>{t("tp.text")}</p>
  </div>
</div>

<style>
  .tp-bar {
    background: var(--ink-100);
    border-bottom: 1px solid var(--border);
  }
  .tp-bar__inner {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    padding-block: 12px;
  }
  .tp-label {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-ink);
    white-space: nowrap;
  }
  .tp-bar p {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--t-sm);
    line-height: 1.6;
  }
</style>
