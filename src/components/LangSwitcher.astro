---
import { getLocale, otherLocale, localizePath, useTranslations, htmlLang } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const target = otherLocale(locale);
const t = useTranslations(locale);
const href = localizePath(Astro.url.pathname, target);
const label = target === "en" ? t("lang.toggleToEn") : t("lang.toggleToZh");
---

<a class="lang-switch" href={href} hreflang={htmlLang(target)} aria-label={t("lang.ariaSwitch")}>
  {label}
</a>

<style>
  .lang-switch {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #d7d6d3;
    text-decoration: none;
    padding: 8px 10px;
    border-radius: var(--r-sm);
    letter-spacing: 0.04em;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .lang-switch:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }
</style>
