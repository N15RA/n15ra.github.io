{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_doc": "n15ra.github.io（nisra-site）專案 Claude Code 設定，初始化自 dev-guidelines 模板。架構與 rationale 見 upstream dev-guidelines MAINTAINER.md#設定檔架構。",
  "attribution": {
    "commit": "",
    "pr": ""
  },

  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },

  "permissions": {
    "allow": [
      "Bash(mise ls*)",
      "Bash(mise current*)",
      "Bash(pre-commit run*)",
      "Read(**/*.md)",
      "Read(**/package.json)",
      "Read(**/package-lock.json)",
      "Read(**/tsconfig.json)",
      "Read(**/tsconfig.*.json)",
      "Read(**/.prettierrc)",
      "Read(**/.prettierrc.json)",
      "Read(**/.eslintrc*)",
      "Read(.claude/settings.json)",
      "Read(**/*.yaml)",
      "Read(**/*.yml)",
      "Read(**/*.toml)",
      "mcp__playwright__*"
    ],
    "ask": ["Bash(curl *)", "Bash(wget *)"],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push --force-if-includes*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push *--force-with-lease*)",
      "Bash(git push *--force-if-includes*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(**/secrets/**)",
      "Read(**/credentials.json)",
      "Read(**/token.json)",
      "Read(.claude/settings.local.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
